# Memora Backend Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# Gemini API Key (optional, for AI caregiver insights)
# Leave empty to use rule-based fallback insights
GEMINI_API_KEY=

# Caregiver Master PIN (used for caregiver dashboard authentication)
# Default is 1234
CAREGIVER_PIN=1234

# Healthcare Worker PIN (used for read-only clinical observation)
# Default is 4321
HEALTHCARE_PIN=4321

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./memora.db
